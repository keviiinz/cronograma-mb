generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String    @id @default(cuid())
  name        String
  startDate   String
  duration    Int
  notes       String    @default("")
  completed   Boolean   @default(false)
  completedAt String?
  noteEntries Note[]
  dayNotes    DayNote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DayNote {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date      String
  title     String        @default("")
  text      String        @default("")
  files     DayNoteFile[]
  author    String        @default("Admin")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([taskId, date])
}

model DayNoteFile {
  id        String   @id @default(cuid())
  dayNoteId String
  dayNote   DayNote  @relation(fields: [dayNoteId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String   @default("image")
  fileName  String   @default("")
  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  color     String   @default("purple")
  author    String
  createdAt DateTime @default(now())
}

model Meeting {
  id        String   @id @default(cuid())
  name      String
  reason    String
  date      String
  time      String
  createdAt DateTime @default(now())
}
